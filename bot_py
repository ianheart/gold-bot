import os
import yfinance as yf
import pandas as pd
import requests

# Get secrets from GitHub (we will add them next)
PHONE = os.environ.get("WHATSAPP_PHONE")
APIKEY = os.environ.get("WHATSAPP_APIKEY")

def get_signal():
    df = yf.download("GC=F", period="5d", interval="15m", progress=False)
    if df.empty:
        return "No data"
    if isinstance(df.columns, pd.MultiIndex):
        df.columns = df.columns.get_level_values(0)
    close = df['Close']
    # RSI 14
    delta = close.diff()
    gain = delta.where(delta > 0, 0).rolling(14).mean()
    loss = -delta.where(delta < 0, 0).rolling(14).mean()
    rs = gain / loss
    rsi = 100 - (100 / (1 + rs))
    last_rsi = float(rsi.iloc[-1])
    price = float(close.iloc[-1])
    if last_rsi < 30:
        return f"XAUUSD BUY @ {price:.2f} | RSI {last_rsi:.1f} - Oversold"
    elif last_rsi > 70:
        return f"XAUUSD SELL @ {price:.2f} | RSI {last_rsi:.1f} - Overbought"
    else:
        return f"XAUUSD HOLD @ {price:.2f} | RSI {last_rsi:.1f} - No clear signal"

msg = get_signal()
print(msg)
# Send via CallMeBot WhatsApp
if PHONE and APIKEY:
    url = f"https://api.callmebot.com/whatsapp.php?phone={PHONE}&text={msg}&apikey={APIKEY}"
    r = requests.get(url)
    print("SENT:", r.text)
else:
    print("No phone/apikey set")
